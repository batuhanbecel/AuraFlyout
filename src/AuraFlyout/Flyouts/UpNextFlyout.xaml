<local:FlyoutWindow x:Class="AuraFlyout.Flyouts.UpNextFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:AuraFlyout.Flyouts"
                    Title="AuraFlyout Up Next">
    <Border x:Name="Root" CornerRadius="8" Width="310" Padding="12" MouseLeftButtonUp="Root_Click" Cursor="Hand">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="5" Margin="0,0,12,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <Grid>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Cover, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                    <Border CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{DynamicResource UpNext_Caption}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Artist}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</local:FlyoutWindow>
