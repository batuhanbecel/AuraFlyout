<local:FlyoutWindow x:Class="AuraFlyout.Flyouts.BrightnessFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AuraFlyout.Flyouts"
                    Title="AuraFlyout Brightness">
    <!-- one row per screen: the built-in panel and every monitor that speaks DDC/CI -->
    <Border x:Name="Root" CornerRadius="8" Width="340" Padding="12,10">
        <StackPanel>
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE706;" FontSize="18" Width="34" Margin="-4,0,4,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,0,0,-2"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Slider Minimum="0" Maximum="100" Focusable="False" Value="{Binding Value, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding Name}"
                                        ValueChanged="Slider_ValueChanged" Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Value, Converter={StaticResource Percent}}" MinWidth="36" FontSize="12"
                                       VerticalAlignment="Center" TextAlignment="Right" Margin="6,8,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource Bright_None}" FontSize="12" TextWrapping="Wrap" Margin="4,6"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <Button Style="{StaticResource AuraIconButton}" Width="Auto" Height="30" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Padding="8,0" Click="DisplaySettings_Click" AutomationProperties.Name="{DynamicResource Bright_Settings}">
                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource Bright_Settings}" FontSize="12" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</local:FlyoutWindow>
