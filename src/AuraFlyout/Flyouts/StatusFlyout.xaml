<local:FlyoutWindow x:Class="AuraFlyout.Flyouts.StatusFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:AuraFlyout.Flyouts"
                    xmlns:c="clr-namespace:AuraFlyout.Controls"
                    Title="AuraFlyout System status">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{DynamicResource AuraCardBrush}" />
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Width="380" Padding="12">
        <StackPanel>
            <Grid Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Status_Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="CpuNameText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource AuraIconButton}" Width="32" Height="30" Click="TaskManager_Click" ToolTip="{DynamicResource Status_TaskManager}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource AuraIconButton}" Width="32" Height="30" Click="Settings_Click" ToolTip="{DynamicResource Tray_Settings}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Cpu" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="CPU" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="CpuText" Style="{StaticResource TileValue}" Text="--" />
                        <TextBlock x:Name="CpuSub" Style="{StaticResource TileSub}" />
                        <c:Sparkline x:Name="CpuChart" Height="26" Margin="0,6,0,0" Maximum="100" Stroke="{DynamicResource AuraAccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Gpu" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="GPU" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="GpuText" Style="{StaticResource TileValue}" Text="--" />
                        <TextBlock x:Name="GpuSub" Style="{StaticResource TileSub}" />
                        <c:Sparkline x:Name="GpuChart" Height="26" Margin="0,6,0,0" Maximum="100" Stroke="{DynamicResource AuraAccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Ram" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="RAM" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="RamText" Style="{StaticResource TileValue}" Text="--" />
                        <TextBlock x:Name="RamSub" Style="{StaticResource TileSub}" />
                        <c:Sparkline x:Name="RamChart" Height="26" Margin="0,6,0,0" Maximum="100" Stroke="{DynamicResource AuraAccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Fps" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="FPS" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="FpsText" Style="{StaticResource TileValue}" Text="--" />
                        <TextBlock x:Name="FpsSub" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Tile}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Status_Network}" Style="{StaticResource TileTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <c:MetricGlyphIcon Kind="Download" Width="12" Height="12" Brush="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,4,0" />
                            <TextBlock x:Name="DownText" FontSize="14" FontWeight="SemiBold" MinWidth="70" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <c:MetricGlyphIcon Kind="Upload" Width="12" Height="12" Brush="{DynamicResource TextFillColorPrimaryBrush}" Margin="8,0,4,0" />
                            <TextBlock x:Name="UpText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <c:Sparkline x:Name="NetChart" Grid.Column="1" Height="30" Maximum="0" Stroke="{DynamicResource AuraAccentBrush}" />
                </Grid>
            </Border>

            <!-- disk activity, video memory, ping -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Tile}" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Disk" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Status_Disk}" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="DiskText" Style="{StaticResource TileValue}" FontSize="16" Text="--" />
                        <c:Sparkline x:Name="DiskChart" Height="18" Margin="0,4,0,0" Maximum="100" Stroke="{DynamicResource AuraAccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Gpu" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="VRAM" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="VramText" Style="{StaticResource TileValue}" FontSize="16" Text="--" />
                        <TextBlock x:Name="VramSub" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:MetricGlyphIcon Kind="Ping" Width="12" Height="12" Brush="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Ping" Style="{StaticResource TileTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="PingText" Style="{StaticResource TileValue}" FontSize="16" Text="--" />
                        <c:Sparkline x:Name="PingChart" Height="18" Margin="0,4,0,0" Maximum="0" Stroke="{DynamicResource AuraAccentBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Windows power mode (Settings › System › Power › Power mode) -->
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Power_Title}" Style="{StaticResource TileTitle}" Margin="0,0,0,6" />
                    <UniformGrid Columns="3">
                        <ToggleButton x:Name="PowerSaver" Style="{StaticResource AuraSegment}" Click="Power_Click" Tag="0" Content="{DynamicResource Power_Efficiency}" Margin="0,0,3,0" />
                        <ToggleButton x:Name="PowerBalanced" Style="{StaticResource AuraSegment}" Click="Power_Click" Tag="1" Content="{DynamicResource Power_Balanced}" Margin="3,0" />
                        <ToggleButton x:Name="PowerBest" Style="{StaticResource AuraSegment}" Click="Power_Click" Tag="2" Content="{DynamicResource Power_Performance}" Margin="3,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border x:Name="AdminHint" Style="{StaticResource Tile}" Visibility="Collapsed" Margin="3,6,3,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AdminHintText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- not focusable: a stray Enter / Space must never trigger elevation -->
                    <ui:Button Grid.Column="1" Margin="10,0,0,0" Appearance="Primary" Content="{DynamicResource Status_RunAsAdmin}"
                               Icon="{ui:FontIcon Glyph=&#xEA18;, FontFamily={x:Static c:FluentIcons.Family}}" Click="Elevate_Click" Focusable="False" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</local:FlyoutWindow>
