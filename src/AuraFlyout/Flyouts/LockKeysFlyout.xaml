<local:FlyoutWindow x:Class="AuraFlyout.Flyouts.LockKeysFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:AuraFlyout.Flyouts"
                    Title="AuraFlyout Lock Keys">
    <!-- one compact line, "Caps Lock on", with the state as a short bar under the words -->
    <Border x:Name="Root" CornerRadius="8" Padding="14,9,18,7">
        <StackPanel Orientation="Horizontal">
            <!-- the lock: shrinks, swaps and pops back while the shackle swings -->
            <TextBlock x:Name="KeyIcon" Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="16" Margin="0,0,10,4"
                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="IconScale" />
                        <RotateTransform x:Name="IconRotate" />
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>

            <StackPanel VerticalAlignment="Center">
                <StackPanel x:Name="Line" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="KeyName" Text="Caps Lock" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="KeyState" Text="on" FontSize="14" Margin="5,0,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="KeyStateMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>

                <!-- the state: a dim accent bar when off, full accent (grown from its middle) when on -->
                <Grid x:Name="Indicator" Height="3" Width="40" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Border CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.3" />
                    <Border x:Name="IndicatorOn" CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="IndicatorScale" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</local:FlyoutWindow>
