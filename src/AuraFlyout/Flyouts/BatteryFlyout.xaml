<local:FlyoutWindow x:Class="AuraFlyout.Flyouts.BatteryFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:AuraFlyout.Flyouts"
                    Title="AuraFlyout Logitech">
    <Window.Resources>
        <DataTemplate x:Key="DeviceCard">
                            <Border x:Name="Card" CornerRadius="8" Padding="12,10" Margin="0,2" Background="{DynamicResource AuraCardBrush}"
                                    MouseRightButtonUp="Device_RightClick" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- a Bluetooth headset / speaker: the icon is its connect switch (filled while connected) -->
                                    <Border x:Name="Icon" Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                            MouseLeftButtonUp="Icon_Click">
                                        <Grid>
                                            <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Border x:Name="Bolt" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-3,-3" Background="{DynamicResource SystemFillColorSuccessBrush}" Visibility="Collapsed">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Grid Height="4" Margin="0,6,0,0" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentStar}}" />
                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentStar}, ConverterParameter=Rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                                            <Border x:Name="Fill" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="Pct" Grid.Column="2" Text="{Binding PercentText}" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Charging}" Value="True">
                                    <Setter TargetName="Bolt" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Full}" Value="True">
                                    <Setter TargetName="Bolt" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Low}" Value="True">
                                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="Pct" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Connected}" Value="False">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                    <Setter TargetName="Icon" Property="Cursor" Value="Hand" />
                                    <Setter TargetName="Icon" Property="ToolTip" Value="{DynamicResource BtAudio_Connect}" />
                                    <Setter TargetName="Card" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanToggle}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, ElementName=Icon}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Icon" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanToggle}" Value="True" />
                                        <Condition Binding="{Binding Connected}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Icon" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    <Setter TargetName="Icon" Property="ToolTip" Value="{DynamicResource BtAudio_Disconnect}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanToggle}" Value="True" />
                                        <Condition Binding="{Binding Connected}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, ElementName=Icon}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Icon" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                    <Setter TargetName="Icon" Property="IsEnabled" Value="False" />
                                    <Setter TargetName="Icon" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Width="360" Padding="12">
        <StackPanel>
            <Grid Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Logi_Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Logi_Subtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource AuraIconButton}" Width="32" Height="30" Click="Refresh_Click" ToolTip="{DynamicResource Logi_Refresh}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource AuraIconButton}" Width="32" Height="30" Click="Settings_Click" ToolTip="{DynamicResource Tray_Settings}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="DeviceList" ItemTemplate="{StaticResource DeviceCard}" />

            <!-- Xbox and PlayStation controllers, over USB, the Xbox adapter or Bluetooth -->
            <StackPanel x:Name="GamepadSection" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Gamepad_Section}" FontSize="12" FontWeight="SemiBold" Margin="4,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="GamepadList" ItemTemplate="{StaticResource DeviceCard}" />
            </StackPanel>

            <!-- Bluetooth devices, with the charge Windows reports (Settings › Bluetooth & devices); a headset's icon connects it -->
            <StackPanel x:Name="BluetoothSection" Visibility="Collapsed">
                <TextBlock Text="Bluetooth" FontSize="12" FontWeight="SemiBold" Margin="4,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="BluetoothList" ItemTemplate="{StaticResource DeviceCard}" />

            </StackPanel>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource Logi_NoDevicesLong}" TextWrapping="Wrap" FontSize="12" Margin="4,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock Text="{DynamicResource Logi_RightClickHint}" FontSize="12" Margin="4,8,4,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Border>
</local:FlyoutWindow>
