<local:FlyoutWindow x:Class="AuraFlyout.Flyouts.VolumeFlyout"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:AuraFlyout.Flyouts"
                    xmlns:core="clr-namespace:AuraFlyout.Core"
                    Title="AuraFlyout Volume">
    <Border x:Name="Root" CornerRadius="8" Width="340" Padding="12,10">
        <StackPanel>
            <!-- master volume -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AuraIconButton}" Click="Mute_Click" Margin="-4,0,0,0" ToolTip="{DynamicResource Volume_Mute}">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="18">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource VolumeIcon}">
                                <Binding Path="Volume" />
                                <Binding Path="IsMuted" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Margin="4,0,8,0" VerticalAlignment="Center" Focusable="False"
                        IsMoveToPointEnabled="True" Value="{Binding Volume, Mode=TwoWay}" ValueChanged="Slider_ValueChanged"
                        Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" />
                <TextBlock Grid.Column="2" Text="{Binding Volume, Converter={StaticResource Percent}}" MinWidth="36" FontSize="12"
                           VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Button x:Name="ExpandButton" Grid.Column="3" Style="{StaticResource AuraIconButton}" Margin="6,0,-4,0" Click="Expand_Click"
                        ToolTip="{DynamicResource Volume_Mixer}">
                    <TextBlock x:Name="ExpandIcon" Style="{StaticResource Glyph}" Text="&#xF4C3;" FontSize="16" />
                </Button>
            </Grid>

            <!-- mixer -->
            <StackPanel x:Name="MixerPanel" Visibility="Collapsed" Margin="0,8,0,2">
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
                <!-- current output; click: pick another one, like "Select a sound output" in the quick settings -->
                <Button Style="{StaticResource AuraRowButton}" Padding="6,4" Margin="-4,0,-4,4" Click="Devices_Click"
                        ToolTip="{DynamicResource Volume_Output}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F5;" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DeviceChevron" Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <!-- the app list, or (after a click on the device) the device list in its place, at the same
                     height: the flyout keeps its size, a resize would show one misplaced frame -->
                <Grid x:Name="MixerBody" ClipToBounds="True">
                <ScrollViewer x:Name="OutputsPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OutputList" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AuraRowButton}" Padding="0,6,8,6" Click="Output_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Name}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Pill" Height="16" CornerRadius="1.5" Opacity="0" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="&#xE7F5;" FontSize="14" Margin="10,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="SessionsPane">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ActiveBar" Width="3" Height="22" CornerRadius="1.5" Opacity="0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Button Grid.Column="1" Style="{StaticResource AuraIconButton}" Width="34" Height="34" Margin="4,0,4,0"
                                            Click="SessionMute_Click" Tag="{Binding}" ToolTip="{DynamicResource Volume_Mute}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="18"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Border x:Name="MutedBadge" Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom" Margin="0,0,-4,-4" Visibility="Collapsed"
                                                    Background="{DynamicResource SystemFillColorCriticalBrush}">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74F;" FontSize="7" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="AppName" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,0,-2" />
                                        <Slider Minimum="0" Maximum="100" Focusable="False" IsMoveToPointEnabled="True"
                                                Value="{Binding Volume, Mode=TwoWay}" ValueChanged="Slider_ValueChanged"
                                                Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Volume, Converter={StaticResource Percent}}" MinWidth="36" FontSize="12"
                                               VerticalAlignment="Center" TextAlignment="Right" Margin="6,8,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter TargetName="MutedBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                            <Condition Binding="{Binding VolumeMixerHighlightActive, Source={x:Static core:SettingsStore.Current}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="ActiveBar" Property="Opacity" Value="1" />
                                        <Setter TargetName="AppName" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="AppName" Property="FontWeight" Value="SemiBold" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource Mixer_Empty}" FontSize="12" Margin="4,6"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                </StackPanel>
                </Grid>
                <Button Style="{StaticResource AuraIconButton}" Width="Auto" Height="30" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Padding="8,0" Click="SoundSettings_Click" AutomationProperties.Name="{DynamicResource Mixer_SoundSettings}">
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Mixer_SoundSettings}" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</local:FlyoutWindow>
