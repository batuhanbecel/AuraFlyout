<UserControl x:Class="AuraFlyout.Settings.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AuraFlyout.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_System}" />

        <c:SettingHeader Text="{DynamicResource System_General}" Margin="0,0,0,8" />
        <c:SettingCard Icon="Rocket24" Title="{DynamicResource System_Startup}" Description="{DynamicResource System_StartupDesc}">
            <ui:ToggleSwitch x:Name="StartupSwitch" Click="Startup_Click" />
        </c:SettingCard>
        <c:SettingCard Icon="Shield24" Title="{DynamicResource System_Elevated}" Description="{DynamicResource System_ElevatedDesc}">
            <ui:ToggleSwitch x:Name="ElevatedSwitch" Click="Elevated_Click" />
        </c:SettingCard>
        <c:SettingCard Icon="Translate24" Title="{DynamicResource System_Language}" Description="{DynamicResource System_LanguageDesc}">
            <ComboBox SelectedIndex="{Binding Language, Converter={StaticResource LanguageIndex}}" MinWidth="180">
                <ComboBoxItem Content="{DynamicResource System_LangAuto}" />
                <ComboBoxItem Content="Türkçe" />
                <ComboBoxItem Content="English" />
            </ComboBox>
        </c:SettingCard>
        <c:SettingCard Icon="EyeOff24" Title="{DynamicResource System_HideTray}" Description="{DynamicResource System_HideTrayDesc}">
            <ui:ToggleSwitch IsChecked="{Binding HideTrayIcon}" />
        </c:SettingCard>
        <c:SettingCard Icon="Desktop24" Title="{DynamicResource System_Fullscreen}" Description="{DynamicResource System_FullscreenDesc}">
            <ui:ToggleSwitch IsChecked="{Binding DisableInFullscreen}" />
        </c:SettingCard>
        <c:SettingCard Icon="DesktopCursor24" Title="{DynamicResource System_Monitor}" Description="{DynamicResource System_MonitorDesc}">
            <ComboBox SelectedIndex="{Binding FlyoutMonitor}" MinWidth="180">
                <ComboBoxItem Content="{DynamicResource System_MonitorPrimary}" />
                <ComboBoxItem Content="{DynamicResource System_MonitorCursor}" />
            </ComboBox>
        </c:SettingCard>

        <c:SettingHeader Text="{DynamicResource System_Appearance}" />
        <c:SettingCard Icon="DarkTheme24" Title="{DynamicResource System_Theme}" Description="{DynamicResource System_ThemeDesc}">
            <ComboBox SelectedIndex="{Binding Theme}" MinWidth="180">
                <ComboBoxItem Content="{DynamicResource System_ThemeSystem}" />
                <ComboBoxItem Content="{DynamicResource System_ThemeLight}" />
                <ComboBoxItem Content="{DynamicResource System_ThemeDark}" />
            </ComboBox>
        </c:SettingCard>
        <c:SettingCard Icon="PaintBrush24" Title="{DynamicResource System_Backdrop}" Description="{DynamicResource System_BackdropDesc}">
            <ComboBox SelectedIndex="{Binding Backdrop}" MinWidth="180">
                <ComboBoxItem Content="{DynamicResource System_BackdropAcrylic}" />
                <ComboBoxItem Content="{DynamicResource System_BackdropSystem}" />
                <ComboBoxItem Content="{DynamicResource System_BackdropSolid}" />
            </ComboBox>
        </c:SettingCard>
        <c:SettingCard Icon="PaintBucket24" Title="{DynamicResource System_Opacity}" Description="{DynamicResource System_OpacityDesc}">
            <StackPanel Orientation="Horizontal">
                <Slider Minimum="0" Maximum="255" TickFrequency="5" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center"
                        Value="{Binding AcrylicOpacity}" />
                <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding AcrylicOpacity}" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Icon="ResizeLarge24" Title="{DynamicResource System_Scale}" Description="{DynamicResource System_ScaleDesc}">
            <StackPanel Orientation="Horizontal">
                <Slider Minimum="75" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center"
                        Value="{Binding FlyoutScale}" />
                <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding FlyoutScale, Converter={StaticResource Percent}}" />
            </StackPanel>
        </c:SettingCard>

        <c:SettingHeader Text="{DynamicResource Install_Header}" />
        <c:SettingCard Icon="Box24" Title="{DynamicResource Install_Title}" Description="{DynamicResource Install_Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="InstallState" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button x:Name="InstallButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="{DynamicResource Install_Button}" Click="Install_Click" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingExpander Icon="ArrowSync24" Title="{DynamicResource Update_Title}" Description="{DynamicResource Update_Desc}">
            <c:SettingExpander.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UpdateState" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button x:Name="UpdateButton" Icon="{ui:SymbolIcon ArrowSync24}" Content="{DynamicResource Update_Check}" Click="Update_Click" />
                </StackPanel>
            </c:SettingExpander.HeaderContent>
            <StackPanel>
                <c:SettingCard Icon="Clock24" Title="{DynamicResource Update_Auto}" Description="{DynamicResource Update_AutoDesc}">
                    <ui:ToggleSwitch IsChecked="{Binding UpdateAutoCheck}" />
                </c:SettingCard>
                <c:SettingCard Icon="Globe24" Title="{DynamicResource Update_Repo}" Description="{DynamicResource Update_RepoDesc}">
                    <ui:TextBox Text="{Binding UpdateRepo, UpdateSourceTrigger=LostFocus}" MinWidth="220" />
                </c:SettingCard>
            </StackPanel>
        </c:SettingExpander>

        <c:SettingHeader Text="{DynamicResource System_Data}" />
        <WrapPanel>
            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon ArrowExportLtr24}" Content="{DynamicResource System_Export}" Click="Export_Click" />
            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon ArrowImport24}" Content="{DynamicResource System_Import}" Click="Import_Click" />
            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon FolderOpen24}" Content="{DynamicResource System_OpenFolder}" Click="OpenFolder_Click" />
            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon ArrowReset24}" Content="{DynamicResource System_Reset}" Click="Reset_Click" />
            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Power24}" Content="{DynamicResource Tray_Exit}" Click="Exit_Click" />
        </WrapPanel>
        <TextBlock x:Name="DataState" FontSize="12" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
