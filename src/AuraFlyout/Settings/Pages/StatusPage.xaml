<UserControl x:Class="AuraFlyout.Settings.Pages.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AuraFlyout.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Status}" />
        <TextBlock Text="{DynamicResource Status_Intro}" TextWrapping="Wrap" Margin="0,-8,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <c:SettingCard Icon="DesktopPulse24" Title="{DynamicResource Status_Enable}" Description="{DynamicResource Status_EnableDesc}">
            <ui:ToggleSwitch IsChecked="{Binding StatusEnabled}" />
        </c:SettingCard>

        <StackPanel IsEnabled="{Binding StatusEnabled}">
            <c:SettingExpander Icon="Eye24" Title="{DynamicResource Status_Show}" Description="{DynamicResource Status_ShowDesc}">
                <StackPanel>
                    <c:SettingCard Icon="DeveloperBoard24" Title="{DynamicResource Status_CpuUsage}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowCpu}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Temperature24" Title="{DynamicResource Status_CpuTemp}" Description="{DynamicResource Status_CpuTempDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowCpuTemp}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Desktop24" Title="{DynamicResource Status_GpuUsage}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowGpu}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Temperature24" Title="{DynamicResource Status_GpuTemp}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowGpuTemp}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Memory16" Title="RAM">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowRam}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Games24" Title="FPS" Description="{DynamicResource Status_FpsDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowFps}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="ArrowSwap24" Title="{DynamicResource Status_Net}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowNet}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="HardDrive20" Title="{DynamicResource Status_Disk}" Description="{DynamicResource Status_DiskDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowDisk}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Memory16" Title="VRAM" Description="{DynamicResource Status_VramDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowVram}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Timer24" Title="Ping" Description="{DynamicResource Status_PingDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowPing}" />
                    </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>

            <c:SettingExpander Icon="TextT24" Title="{DynamicResource Media_Layout}" Description="{DynamicResource Status_LookDesc}">
                <StackPanel>
                    <c:SettingCard Icon="TextAlignJustify24" Title="{DynamicResource Status_TwoLines}" Description="{DynamicResource Status_TwoLinesDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusTwoLines}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Sparkle24" Title="{DynamicResource Status_Glyphs}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowGlyphs}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="TextT24" Title="{DynamicResource Status_Labels}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusShowLabels}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Color24" Title="{DynamicResource Status_Warnings}" Description="{DynamicResource Status_WarningsDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusColorWarnings}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Memory16" Title="{DynamicResource Status_RamGb}">
                        <ui:ToggleSwitch IsChecked="{Binding StatusRamAsGb}" />
                    </c:SettingCard>
                    <c:SettingCard Icon="Timer24" Title="{DynamicResource Status_Interval}">
                        <ComboBox x:Name="IntervalCombo" MinWidth="180" SelectionChanged="Interval_Changed">
                            <ComboBoxItem Content="0.5 s" Tag="500" />
                            <ComboBoxItem Content="1 s" Tag="1000" />
                            <ComboBoxItem Content="2 s" Tag="2000" />
                            <ComboBoxItem Content="5 s" Tag="5000" />
                        </ComboBox>
                    </c:SettingCard>
                    <!-- text size / weight are shared by every taskbar item: set once, on the layout page -->
                    <c:SettingCard Icon="TextFontSize24" Title="{DynamicResource Layout_TextStyle}" Description="{DynamicResource Layout_TextStyleDesc}">
                        <ui:Button Content="{DynamicResource Nav_Layout}" Icon="{ui:SymbolIcon AppsList24}" Click="Layout_Click" />
                    </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>

            <c:SettingExpander Icon="AlignLeft24" Title="{DynamicResource Dock_Header}" Description="{DynamicResource Layout_OpenDesc}">
                <StackPanel>
                    <c:SettingCard Icon="AlignLeft24" Title="{DynamicResource Common_Position}">
                        <ui:Button Content="{DynamicResource Nav_Layout}" Icon="{ui:SymbolIcon AppsList24}" Click="Layout_Click" />
                    </c:SettingCard>
                    <c:SettingCard Icon="ArrowSwap24" Title="{DynamicResource Taskbar_Offset}" Description="{DynamicResource Dock_OffsetDesc}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="-100" Maximum="400" TickFrequency="2" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding StatusOffset}" />
                            <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding StatusOffset, StringFormat={}{0} px}" />
                        </StackPanel>
                    </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>

            <c:SettingExpander Icon="Alert24" Title="{DynamicResource Alert_Enable}" Description="{DynamicResource Alert_EnableDesc}">
                <c:SettingExpander.HeaderContent>
                    <ui:ToggleSwitch IsChecked="{Binding AlertsEnabled}" />
                </c:SettingExpander.HeaderContent>
                <StackPanel IsEnabled="{Binding AlertsEnabled}">
                    <c:SettingCard Icon="Temperature24" Title="{DynamicResource Alert_CpuTemp}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="60" Maximum="105" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding AlertCpuTemp}" />
                            <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding AlertCpuTemp, StringFormat={}{0} °C}" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Icon="Temperature24" Title="{DynamicResource Alert_GpuTemp}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="60" Maximum="105" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding AlertGpuTemp}" />
                            <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding AlertGpuTemp, StringFormat={}{0} °C}" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Icon="Memory16" Title="{DynamicResource Alert_Ram}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="70" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding AlertRam}" />
                            <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding AlertRam, Converter={StaticResource Percent}}" />
                        </StackPanel>
                    </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>

            <c:SettingExpander Icon="Temperature24" Title="{DynamicResource Status_Sensors}" Description="{DynamicResource Status_SensorsDesc}">
                <StackPanel>
                    <!-- the switch itself lives on the System page; here only its state and a way there -->
                    <c:SettingCard Icon="Shield24" Title="{DynamicResource System_Elevated}" Description="{DynamicResource System_ElevatedDesc}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ElevatedState" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Content="{DynamicResource Nav_System}" Icon="{ui:SymbolIcon Settings24}" Click="System_Click" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard x:Name="PawnIoCard" Icon="Temperature24" Title="PawnIO" Description="{DynamicResource Status_PawnIoDesc}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PawnIoState" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button x:Name="PawnIoButton" Content="pawnio.eu" Icon="{ui:SymbolIcon Open24}" Click="PawnIo_Click" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Icon="Info24" Title="{DynamicResource Status_TempSource}">
                        <TextBlock x:Name="SourceText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>
        </StackPanel>
    </StackPanel>
</UserControl>
