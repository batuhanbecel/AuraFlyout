<UserControl x:Class="AuraFlyout.Settings.Pages.VolumePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AuraFlyout.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Volume}" />

        <c:SettingCard Icon="Speaker224" Title="{DynamicResource Volume_Enable}" Description="{DynamicResource Volume_EnableDesc}">
            <ui:ToggleSwitch IsChecked="{Binding VolumeFlyoutEnabled}" />
        </c:SettingCard>
        <c:SettingCard Icon="EyeOff24" Title="{DynamicResource Volume_HideNative}" Description="{DynamicResource Volume_HideNativeDesc}">
            <ui:ToggleSwitch IsChecked="{Binding HideNativeVolumeOsd}" />
        </c:SettingCard>
        <c:SettingCard Icon="Speaker224" Title="{DynamicResource Volume_TraySpeaker}" Description="{DynamicResource Volume_TraySpeakerDesc}">
            <ui:ToggleSwitch IsChecked="{Binding TraySpeakerOpensMixer}" />
        </c:SettingCard>
        <c:SettingCard Icon="AlignBottom24" Title="{DynamicResource Common_Position}" Description="{DynamicResource Volume_PositionDesc}">
            <ComboBox SelectedIndex="{Binding VolumeFlyoutPosition}" MinWidth="180">
                <ComboBoxItem Content="{DynamicResource Pos_BottomCenter}" />
                <ComboBoxItem Content="{DynamicResource Pos_BottomLeft}" />
                <ComboBoxItem Content="{DynamicResource Pos_BottomRight}" />
                <ComboBoxItem Content="{DynamicResource Pos_TopCenter}" />
                <ComboBoxItem Content="{DynamicResource Pos_TopLeft}" />
                <ComboBoxItem Content="{DynamicResource Pos_TopRight}" />
            </ComboBox>
        </c:SettingCard>
        <c:SettingCard Icon="Timer24" Title="{DynamicResource Common_Duration}" Description="{DynamicResource Common_DurationDesc}">
            <StackPanel Orientation="Horizontal">
                <Slider Minimum="1000" Maximum="8000" TickFrequency="250" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center"
                        Value="{Binding VolumeFlyoutDuration}" />
                <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding VolumeFlyoutDuration, Converter={StaticResource MsToSeconds}}" />
            </StackPanel>
        </c:SettingCard>
        <!-- the mixer's shortcut is one of the global shortcuts, set on their page -->
        <c:SettingCard Icon="Keyboard24" Title="{DynamicResource Volume_Shortcut}" Description="{DynamicResource Volume_ShortcutDesc}">
            <ui:Button Content="{DynamicResource Nav_Hotkeys}" Icon="{ui:SymbolIcon Keyboard24}" Click="Hotkeys_Click" />
        </c:SettingCard>
        <c:SettingCard Icon="ArrowSwap24" Title="{DynamicResource Volume_Step}" Description="{DynamicResource Volume_StepDesc}">
            <StackPanel Orientation="Horizontal">
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center"
                        Value="{Binding VolumeStep}" />
                <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding VolumeStep, Converter={StaticResource Percent}}" />
            </StackPanel>
        </c:SettingCard>

        <c:SettingHeader Text="{DynamicResource Volume_MixerHeader}" />
        <c:SettingCard Icon="Pulse24" Title="{DynamicResource Volume_Highlight}" Description="{DynamicResource Volume_HighlightDesc}">
            <ui:ToggleSwitch IsChecked="{Binding VolumeMixerHighlightActive}" />
        </c:SettingCard>
        <ui:Button Margin="0,8,0,0" Icon="{ui:SymbolIcon AppsList24}" Content="{DynamicResource Volume_OpenMixer}" Click="OpenMixer_Click" />
    </StackPanel>
</UserControl>
