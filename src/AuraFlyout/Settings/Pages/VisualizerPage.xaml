<UserControl x:Class="AuraFlyout.Settings.Pages.VisualizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AuraFlyout.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Visualizer}" />
        <ui:InfoBar Message="{DynamicResource Vis_Info}" IsOpen="True" IsClosable="False"
                    Severity="Informational" Margin="0,0,0,12" />

        <c:SettingCard Icon="DataBarVertical24" Title="{DynamicResource Vis_Enable}" Description="{DynamicResource Vis_EnableDesc}">
            <ui:ToggleSwitch IsChecked="{Binding VisualizerEnabled}" />
        </c:SettingCard>

        <StackPanel IsEnabled="{Binding VisualizerEnabled}">
            <c:SettingCard Icon="AlignLeft24" Title="{DynamicResource Common_Position}" Description="{DynamicResource Vis_PositionDesc}">
                <ComboBox SelectedIndex="{Binding VisualizerPosition}" MinWidth="180">
                    <ComboBoxItem Content="{DynamicResource Vis_Before}" />
                    <ComboBoxItem Content="{DynamicResource Vis_After}" />
                    <ComboBoxItem Content="{DynamicResource Vis_Inline}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Icon="DataBarVertical24" Title="{DynamicResource Vis_Bars}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="3" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center"
                            Value="{Binding VisualizerBarCount}" />
                    <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding VisualizerBarCount}" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Icon="AlignCenterVertical24" Title="{DynamicResource Vis_Centered}" Description="{DynamicResource Vis_CenteredDesc}">
                <ui:ToggleSwitch IsChecked="{Binding VisualizerCentered}" />
            </c:SettingCard>
            <c:SettingCard Icon="Pulse24" Title="{DynamicResource Vis_Sensitivity}" Description="{DynamicResource Vis_SensitivityDesc}">
                <ComboBox SelectedIndex="{Binding VisualizerSensitivity}" MinWidth="180">
                    <ComboBoxItem Content="{DynamicResource Vis_Low}" />
                    <ComboBoxItem Content="{DynamicResource Vis_Medium}" />
                    <ComboBoxItem Content="{DynamicResource Vis_High}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Icon="Color24" Title="{DynamicResource Vis_Accent}" Description="{DynamicResource Vis_AccentDesc}">
                <ui:ToggleSwitch IsChecked="{Binding VisualizerUseAccent}" />
            </c:SettingCard>
            <c:SettingCard Icon="MusicNote224" Title="{DynamicResource Media_Spectrum}" Description="{DynamicResource Media_SpectrumDesc}">
                <ui:ToggleSwitch IsChecked="{Binding VisualizerInFlyout}" />
            </c:SettingCard>
        </StackPanel>
    </StackPanel>
</UserControl>
