<UserControl x:Class="AuraFlyout.Settings.Pages.LogiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AuraFlyout.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Logi}" />
        <TextBlock Text="{DynamicResource Logi_Intro}" TextWrapping="Wrap" Margin="0,-8,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <c:SettingCard Icon="Battery524" Title="{DynamicResource Logi_Enable}" Description="{DynamicResource Logi_EnableDesc}">
            <ui:ToggleSwitch IsChecked="{Binding LogiEnabled}" />
        </c:SettingCard>

        <StackPanel IsEnabled="{Binding LogiEnabled}">
            <c:SettingHeader Text="{DynamicResource Logi_Devices}" />
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:SettingCard Title="{Binding Name}" Description="{Binding StatusText}" Icon="Empty">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PercentText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:Button Content="{DynamicResource Logi_Rename}" Icon="{ui:SymbolIcon Rename24}" Margin="0,0,6,0" Tag="{Binding}" Click="Rename_Click" />
                                <ui:Button Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,6,0" Tag="{Binding}" Click="Hide_Click" ToolTip="{DynamicResource Logi_Hide}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Tag="{Binding}" Click="Forget_Click" ToolTip="{DynamicResource Logi_Forget}"
                                           IsEnabled="{Binding Connected, Converter={StaticResource InvertBool}}"
                                           Visibility="{Binding CanForget, Converter={StaticResource BoolToVis}, ConverterParameter=Hidden}" />
                            </StackPanel>
                        </c:SettingCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoDevices" Text="{DynamicResource Logi_NoDevicesLong}" TextWrapping="Wrap" Margin="4,0,0,8"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:Button Content="{DynamicResource Logi_Refresh}" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,4,0,0" Click="Refresh_Click" />

            <!-- the sources besides Logitech: their own group, so the refresh button closes the device list -->
            <c:SettingHeader Text="{DynamicResource Logi_OtherDevices}" />
            <c:SettingCard Icon="Bluetooth24" Title="{DynamicResource Logi_Bluetooth}" Description="{DynamicResource Logi_BluetoothDesc}">
                <ui:ToggleSwitch IsChecked="{Binding BluetoothBatteryEnabled}" />
            </c:SettingCard>
            <c:SettingCard Icon="XboxController24" Title="{DynamicResource Logi_Gamepads}" Description="{DynamicResource Logi_GamepadsDesc}">
                <ui:ToggleSwitch IsChecked="{Binding GamepadBatteryEnabled}" />
            </c:SettingCard>

            <c:SettingExpander Icon="Alert24" Title="{DynamicResource Logi_Notifications}" Description="{DynamicResource Logi_NotificationsDesc}">
                <StackPanel>
            <c:SettingCard Icon="Alert24" Title="{DynamicResource Logi_WindowsNotify}" Description="{DynamicResource Logi_WindowsNotifyDesc}">
                <ui:ToggleSwitch IsChecked="{Binding UseWindowsNotifications}" />
            </c:SettingCard>
            <c:SettingCard Icon="PlugConnected24" Title="{DynamicResource Logi_NotifyConnect}">
                <ui:ToggleSwitch IsChecked="{Binding LogiNotifyConnect}" />
            </c:SettingCard>
            <c:SettingCard Icon="PlugDisconnected24" Title="{DynamicResource Logi_NotifyDisconnect}">
                <ui:ToggleSwitch IsChecked="{Binding LogiNotifyDisconnect}" />
            </c:SettingCard>
            <c:SettingCard Icon="BatteryWarning24" Title="{DynamicResource Logi_NotifyLow}">
                <ui:ToggleSwitch IsChecked="{Binding LogiNotifyLow}" />
            </c:SettingCard>
            <c:SettingCard Icon="BatteryCharge24" Title="{DynamicResource Logi_NotifyFull}">
                <ui:ToggleSwitch IsChecked="{Binding LogiNotifyFull}" />
            </c:SettingCard>
            <c:SettingCard Icon="Battery224" Title="{DynamicResource Logi_LowLevel}" Description="{DynamicResource Logi_LowLevelDesc}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="5" Maximum="30" TickFrequency="5" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding LogiLowThreshold}" />
                    <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding LogiLowThreshold, Converter={StaticResource Percent}}" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Icon="Alert24" Title="{DynamicResource Logi_TestNotification}" Description="{DynamicResource Logi_TestNotificationDesc}">
                <ui:Button Content="{DynamicResource Home_Try}" Click="Test_Click" />
            </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>

            <c:SettingHeader Text="{DynamicResource Media_Layout}" />
            <c:SettingCard Icon="TextNumberFormat24" Title="{DynamicResource Logi_ShowPercent}">
                <ui:ToggleSwitch IsChecked="{Binding LogiShowPercent}" />
            </c:SettingCard>
            <c:SettingCard Icon="Timer24" Title="{DynamicResource Logi_Poll}" Description="{DynamicResource Logi_PollDesc}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="30" Maximum="300" TickFrequency="30" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding LogiPollSeconds}" />
                    <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding LogiPollSeconds, Converter={StaticResource Seconds}}" />
                </StackPanel>
            </c:SettingCard>

            <c:SettingHeader Text="{DynamicResource Dock_Header}" />
            <c:SettingCard Icon="AlignRight24" Title="{DynamicResource Common_Position}" Description="{DynamicResource Layout_OpenDesc}">
                <ui:Button Content="{DynamicResource Nav_Layout}" Icon="{ui:SymbolIcon AppsList24}" Click="Layout_Click" />
            </c:SettingCard>
            <c:SettingCard Icon="ArrowSwap24" Title="{DynamicResource Taskbar_Offset}" Description="{DynamicResource Dock_OffsetDesc}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="-100" Maximum="400" TickFrequency="2" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding LogiOffset}" />
                    <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding LogiOffset, StringFormat={}{0} px}" />
                </StackPanel>
            </c:SettingCard>

            <c:SettingHeader Text="{DynamicResource System_Data}" />
            <c:SettingCard Icon="DocumentBulletList24" Title="{DynamicResource Logi_DebugLog}" Description="{DynamicResource Logi_DebugLogDesc}">
                <ui:ToggleSwitch IsChecked="{Binding LogiDebugLog}" />
            </c:SettingCard>
        </StackPanel>
    </StackPanel>
</UserControl>
