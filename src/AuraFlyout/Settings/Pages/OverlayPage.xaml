<UserControl x:Class="AuraFlyout.Settings.Pages.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:AuraFlyout.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Overlay}" />
        <TextBlock Text="{DynamicResource Overlay_Intro}" TextWrapping="Wrap" Margin="0,-8,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <c:SettingCard Icon="Games24" Title="{DynamicResource Overlay_Enable}" Description="{DynamicResource Overlay_EnableDesc}">
            <ui:ToggleSwitch IsChecked="{Binding OverlayEnabled}" />
        </c:SettingCard>

        <StackPanel IsEnabled="{Binding OverlayEnabled}">
            <c:SettingCard Icon="Eye24" Title="{DynamicResource Overlay_When}" Description="{DynamicResource Overlay_WhenDesc}">
                <ComboBox SelectedIndex="{Binding OverlayMode}" MinWidth="200">
                    <ComboBoxItem Content="{DynamicResource Overlay_Games}" />
                    <ComboBoxItem Content="{DynamicResource Overlay_Always}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Icon="Keyboard24" Title="{DynamicResource Overlay_Hotkey}" Description="{DynamicResource Overlay_HotkeyDesc}">
                <ui:Button Content="{DynamicResource Nav_Hotkeys}" Icon="{ui:SymbolIcon Keyboard24}" Click="Hotkeys_Click" />
            </c:SettingCard>

            <c:SettingExpander Icon="Eye24" Title="{DynamicResource Overlay_Show}" Description="{DynamicResource Overlay_ShowDesc}" IsExpanded="True">
                <StackPanel>
            <c:SettingCard Icon="DeveloperBoard24" Title="CPU">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowCpu}" />
            </c:SettingCard>
            <c:SettingCard Icon="Desktop24" Title="GPU">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowGpu}" />
            </c:SettingCard>
            <c:SettingCard Icon="Temperature24" Title="{DynamicResource Overlay_Temps}">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowTemps}" />
            </c:SettingCard>
            <c:SettingCard Icon="Memory16" Title="RAM">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowRam}" />
            </c:SettingCard>
            <c:SettingCard Icon="Memory16" Title="VRAM">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowVram}" />
            </c:SettingCard>
            <c:SettingCard Icon="Timer24" Title="Ping" Description="{DynamicResource Status_PingDesc}">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowPing}" />
            </c:SettingCard>
            <c:SettingCard Icon="Games24" Title="FPS" Description="{DynamicResource Status_FpsDesc}">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowFps}" />
            </c:SettingCard>
            <c:SettingCard Icon="TimerOff24" Title="{DynamicResource Overlay_Frametime}">
                <ui:ToggleSwitch IsChecked="{Binding OverlayShowFrametime}" />
            </c:SettingCard>

                </StackPanel>
            </c:SettingExpander>

            <c:SettingExpander Icon="PaintBrush24" Title="{DynamicResource Media_Layout}" Description="{DynamicResource Overlay_LookDesc}">
                <StackPanel>
            <c:SettingCard Icon="LayoutRowTwo24" Title="{DynamicResource Overlay_Layout}" Description="{DynamicResource Overlay_LayoutDesc}">
                <ComboBox SelectedIndex="{Binding OverlayLayout}" MinWidth="200">
                    <ComboBoxItem Content="{DynamicResource Overlay_LayoutBar}" />
                    <ComboBoxItem Content="{DynamicResource Overlay_LayoutList}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Icon="AlignTop24" Title="{DynamicResource Common_Position}">
                <ComboBox SelectedIndex="{Binding OverlayPosition}" MinWidth="200">
                    <ComboBoxItem Content="{DynamicResource Pos_TopLeft}" />
                    <ComboBoxItem Content="{DynamicResource Pos_TopRight}" />
                    <ComboBoxItem Content="{DynamicResource Pos_BottomLeft}" />
                    <ComboBoxItem Content="{DynamicResource Pos_BottomRight}" />
                </ComboBox>
            </c:SettingCard>
            <c:SettingCard Icon="TextFontSize24" Title="{DynamicResource Status_FontSize}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="10" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding OverlayFontSize}" />
                    <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding OverlayFontSize, StringFormat={}{0} px}" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Icon="PaintBucket24" Title="{DynamicResource Overlay_Background}">
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="255" TickFrequency="5" IsSnapToTickEnabled="True" Width="180" VerticalAlignment="Center" Value="{Binding OverlayOpacity}" />
                    <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding OverlayOpacity}" />
                </StackPanel>
            </c:SettingCard>
                </StackPanel>
            </c:SettingExpander>
            <TextBlock Text="{DynamicResource Overlay_Note}" TextWrapping="Wrap" FontSize="12" Margin="2,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
